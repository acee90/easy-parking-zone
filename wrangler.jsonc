{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "easy-parking-zone",
	"main": "src/server/worker-entry.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"VITE_NAVER_MAP_CLIENT_ID": "uw8likbp4e",
		"BETTER_AUTH_URL": "https://easy-parking.xyz"
		// CRAWL4AI_URL: Cloudflare Secrets로 관리 (wrangler secret put CRAWL4AI_URL)
	},
	// 매시 → 2시간 간격 (2026-08-19). D1 rows_read 절감 목적.
	//
	// selectPriorityLots 는 상위 N개를 고르려고 parking_lots 31,994행을 매번 스캔한다
	// (ORDER BY 1순위가 LEFT JOIN 된 parking_lot_stats.reliability 라 어떤 인덱스도 못 탐).
	// 호출당 약 96k행 × 크롤러 3종 × 24회/일 ≈ 7M행/일 — 무료 한도 5M/일을 이것만으로 초과.
	// 실행 횟수를 절반으로 줄이면 이 비용도 절반이 된다.
	//
	// 배치 크기는 **올리지 않는다**: subrequest 1,000개/invocation 한도가 있고
	// naver 만으로 이미 ~500개를 쓴다(naver-blogs.ts 주석). 2배로 올리면 한도를 넘겨
	// 같은 invocation 의 youtube/fulltext/match 가 실패한다.
	// 따라서 크롤 처리량은 절반이 된다 — 전 주차장 재크롤 주기가 약 13일 → 26일로 늘지만
	// RECRAWL_DAYS=30 정책 안이라 문제 없다.
	//
	// 근본 해결은 crawl_queue materialize (선택을 인덱스 조회로 전환, 호출당 ~50행).
	"triggers": {
		"crons": [
			"0 */2 * * *",
			"30 */2 * * *",
			// 종합 요약 전용. 메인과 wall time·subrequest 한도를 분리한다.
			// 라우팅은 worker-entry.ts 가 **분(minute) 필드**로 판정한다.
			"45 * * * *"
		]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// 메시지 단위는 **작업 1건**이다 (raw 1건 / lot 1곳).
	// 여러 건을 한 메시지에 담으면 1건이 실패할 때 묶음 전체가 재시도된다 — 크론에서
	// 벗어나려던 이유가 그거였다. 배치는 max_batch_size 가 대신 한다.
	// 비용은 판단 근거가 아니다: 월 약 36만 작업으로 무료 한도(100만) 안이다.
	"queues": {
		"producers": [
			{
				"binding": "SCORE_RECOMPUTE_QUEUE",
				"queue": "score-recompute-queue"
			},
			{
				"binding": "SOURCE_FILTER_QUEUE",
				"queue": "source-filter-queue"
			}
		],
		"consumers": [
			{
				// ⚠️ 25를 올리지 말 것. scoring-engine 이 lot id 를 두 번 바인딩해서
				//    (25 → 50개) D1 의 쿼리당 바인딩 한도 100에 걸린다.
				"queue": "score-recompute-queue",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 3
			},
			{
				// AI 없음(건당 10ms 미만) → 배치를 최대로. 100건을 쿼리 두 번으로 처리한다.
				// 배치가 작으면 D1 왕복이 그만큼 늘어난다 — 크론 주기까지 늘려 아껴온 자원이다.
				"queue": "source-filter-queue",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				"max_retries": 3,
				// 최종 실패를 눈에 보이게 남긴다. 크론에는 이런 자리가 없었다.
				"dead_letter_queue": "source-filter-dlq"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "parking-db",
			"database_id": "ff5d77af-8ca6-4e5c-acf2-2fdf765dd248",
			"migrations_dir": "migrations"
		}
	],
	// 대량 스크래핑 방지용 IP 기준 rate limit. period는 10 또는 60초만 지원.
	// fetchParkingDetail은 wiki 상세페이지 SSR(구글봇 등 정상 크롤러 포함)에서도 호출되므로
	// 느슨하게(1req/s) 잡는다 — 목적은 색인 차단이 아니라 초당 수십~수백 건 enumerate 차단.
	"ratelimits": [
		{
			"name": "RATE_LIMITER_POINTS",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "RATE_LIMITER_DETAIL",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		},
		// 기본정보 유저 제보. 사람이 폼을 채워 내는 속도라 빡빡하게 잡는다 —
		// applied 는 화면에 즉시 서므로 자동화된 연타를 먼저 막아야 한다
		{
			"name": "RATE_LIMITER_EDIT",
			"namespace_id": "1003",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
